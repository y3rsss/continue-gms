{
  "rewrites": [
    {
      "source": "/games/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|crawler|spider|facebookexternalhit|WhatsApp|Slack|Discord|Telegram|Embedly|Iframely|SkypeUriPreview|vkShare|Pinterest|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api/share?slug=:slug"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
